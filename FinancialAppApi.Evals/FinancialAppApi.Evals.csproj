<Project Sdk="Microsoft.NET.Sdk">

  <!-- Live evaluation of Ask AI against the real provider. Not a test project: it spends tokens,
       so it runs only on demand (see README.md) and never as part of dotnet test. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>4b6f3c94-1d61-4fff-902e-45ed68869c02</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FinancialAppApi\FinancialAppApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <None Update="golden-questions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
