          "scheduleFrequency": "Monthly",
          "scheduleDueDay": 1,
          "scheduleStartDate": "2026-08-01",
          "scheduleStatus": "Complete"
        },
        "inputs": []
      },
      "expected": {
        "outstandingBalance": 1200.0,
        "scheduledPayment": 110.0,
        "totalScheduledInterest": 120.0,
        "totalInterestPaid": 0.0,
        "payoffDate": "2027-07-01",
        "lastOccurrenceDate": null,
        "paymentCount": 0,
        "futureScheduleCount": 12
      }
    },
    {
