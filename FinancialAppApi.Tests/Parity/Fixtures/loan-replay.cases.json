{
  "domain": "loan-replay",
  "version": 1,
  "cases": [
    {
      "id": "fresh-flat-loan-no-payments",
      "why": "A newly added loan with no payments has outstanding balance equal to opening principal and full future schedule.",
      "input": {
        "loan": {
          "openingPrincipal": 1200.0,
          "annualRatePercent": 10.0,
          "termPeriods": 12,
          "interestMethod": "Flat",
          "trackingStartDate": "2026-08-01",
          "scheduleFrequency": "Monthly",
          "scheduleDueDay": 1,
          "scheduleStartDate": "2026-08-01",
          "scheduleStatus": "Complete"
        },
        "inputs": []
      },
      "expected": {
        "outstandingBalance": 1200.0,
        "scheduledPayment": 110.0,
        "totalScheduledInterest": 120.0,
        "totalInterestPaid": 0.0,
        "payoffDate": "2027-07-01",
        "lastOccurrenceDate": null,
        "paymentCount": 0,
        "futureScheduleCount": 12
      }
    },
    {
      "id": "partially-paid-reducing-balance",
      "why": "A loan with 2 payments made replays the payment splits, updates outstanding balance and schedules remaining periods.",
      "input": {
        "loan": {
          "openingPrincipal": 600.0,
          "annualRatePercent": 0.0,
          "termPeriods": 6,
          "interestMethod": "ReducingBalance",
          "trackingStartDate": "2026-08-01",
          "scheduleFrequency": "Monthly",
          "scheduleDueDay": 1,
          "scheduleStartDate": "2026-08-01",
          "scheduleStatus": "Complete"
        },
        "inputs": [
          {
            "occurrenceDate": "2026-08-01",
            "amount": 100.0,
            "isDiscarded": false
          },
          {
            "occurrenceDate": "2026-09-01",
            "amount": 100.0,
            "isDiscarded": false
          }
        ]
      },
      "expected": {
        "outstandingBalance": 400.0,
        "scheduledPayment": 100.0,
        "totalScheduledInterest": 0.0,
        "totalInterestPaid": 0.0,
        "payoffDate": "2027-01-01",
        "lastOccurrenceDate": "2026-09-01",
        "paymentCount": 2,
        "futureScheduleCount": 4
      }
    },
    {
      "id": "early-payoff-lump-sum",
      "why": "A lump-sum payment that clears the outstanding balance leaves futureSchedule empty and sets payoffDate.",
      "input": {
        "loan": {
          "openingPrincipal": 1000.0,
          "annualRatePercent": 0.0,
          "termPeriods": 10,
          "interestMethod": "ReducingBalance",
          "trackingStartDate": "2026-08-01",
          "scheduleFrequency": "Monthly",
          "scheduleDueDay": 1,
          "scheduleStartDate": "2026-08-01",
          "scheduleStatus": "Complete"
        },
        "inputs": [
          {
            "occurrenceDate": "2026-08-01",
            "amount": 1000.0,
            "isDiscarded": false
          }
        ]
      },
      "expected": {
        "outstandingBalance": 0.0,
        "scheduledPayment": 100.0,
        "totalScheduledInterest": 0.0,
        "totalInterestPaid": 0.0,
        "payoffDate": "2026-08-01",
        "lastOccurrenceDate": "2026-08-01",
        "paymentCount": 1,
        "futureScheduleCount": 0
      }
    },
    {
      "id": "tracking-starts-before-the-schedule-year",
      "why": "Tracking may begin before the linked bill does; the first scheduled occurrence is the bill own start date, not a month derived from both bounds.",
      "input": {
        "loan": {
          "openingPrincipal": 600.0,
          "annualRatePercent": 0.0,
          "termPeriods": 6,
          "interestMethod": "ReducingBalance",
          "trackingStartDate": "2026-09-06",
          "scheduleFrequency": "Monthly",
          "scheduleDueDay": 10,
          "scheduleStartDate": "2027-01-10",
          "scheduleStatus": "Complete"
        },
        "inputs": []
      },
      "expected": {
        "outstandingBalance": 600.0,
        "scheduledPayment": 100.0,
        "totalScheduledInterest": 0.0,
        "totalInterestPaid": 0.0,
        "payoffDate": "2027-06-10",
        "lastOccurrenceDate": null,
        "paymentCount": 0,
        "futureScheduleCount": 6,
        "firstFutureOccurrenceDate": "2027-01-10"
      }
    },
    {
      "id": "daily-rest-accrual-after-part-payment",
      "why": "Daily-rest interest is accrued once per elapsed date interval after a part payment.",
      "input": {
        "loan": {
          "openingPrincipal": 1000,
          "termPeriods": 10,
          "trackingStartDate": "2026-01-01",
          "scheduleStartDate": "2026-01-01",
          "scheduleFrequency": "Monthly",
          "scheduleDueDay": 1,
          "scheduleStatus": "Complete",
          "annualRatePercent": 12,
          "interestMethod": "ReducingBalanceDaily"
        },
        "inputs": [
          {
            "occurrenceDate": "2026-02-01",
            "amount": 50,
            "isDiscarded": false
          },
          {
            "occurrenceDate": "2026-03-01",
            "amount": 50,
            "isDiscarded": false
          }
        ]
      },
      "expected": {
        "outstandingBalance": 919.03,
        "scheduledPayment": 105.58,
        "totalScheduledInterest": 55.8,
        "totalInterestPaid": 19.03,
        "payoffDate": "2026-12-01",
        "lastOccurrenceDate": "2026-03-01",
        "paymentCount": 2,
        "futureScheduleCount": 10,
        "firstFutureOccurrenceDate": "2026-03-01"
      }
    },
    {
      "id": "discard-wins-over-payments-for-the-same-occurrence",
      "why": "Replay excludes the entire occurrence if it was discarded, even if a prior payment row remains.",
      "input": {
        "loan": {
          "openingPrincipal": 1000,
          "termPeriods": 10,
          "trackingStartDate": "2026-01-01",
          "scheduleStartDate": "2026-01-01",
          "scheduleFrequency": "Monthly",
          "scheduleDueDay": 1,
          "scheduleStatus": "Complete",
          "annualRatePercent": 0,
          "interestMethod": "ReducingBalance"
        },
        "inputs": [
          {
            "occurrenceDate": "2026-01-01",
            "amount": 50,
            "isDiscarded": false
          },
          {
            "occurrenceDate": "2026-01-01",
            "amount": 0,
            "isDiscarded": true
          }
        ]
      },
      "expected": {
        "outstandingBalance": 1000,
        "scheduledPayment": 100,
        "totalScheduledInterest": 0,
        "totalInterestPaid": 0,
        "payoffDate": "2026-11-01",
        "lastOccurrenceDate": "2026-01-01",
        "paymentCount": 0,
        "futureScheduleCount": 10,
        "firstFutureOccurrenceDate": "2026-02-01"
      }
    },
    {
      "id": "final-schedule-payment-is-capped",
      "why": "The last scheduled debit is limited to the principal and interest still owed.",
      "input": {
        "loan": {
          "openingPrincipal": 1000,
          "termPeriods": 10,
          "trackingStartDate": "2026-01-01",
          "scheduleStartDate": "2026-01-01",
          "scheduleFrequency": "Monthly",
          "scheduleDueDay": 1,
          "scheduleStatus": "Complete",
          "annualRatePercent": 0,
          "interestMethod": "ReducingBalance"
        },
        "inputs": [
          {
            "occurrenceDate": "2026-01-01",
            "amount": 950,
            "isDiscarded": false
          }
        ]
      },
      "expected": {
        "outstandingBalance": 50,
        "scheduledPayment": 100,
        "totalScheduledInterest": 0,
        "totalInterestPaid": 0,
        "payoffDate": "2026-02-01",
        "lastOccurrenceDate": "2026-01-01",
        "paymentCount": 1,
        "futureScheduleCount": 1,
        "firstFutureOccurrenceDate": "2026-02-01",
        "firstFuturePayment": 50
      }
    },
    {
      "id": "bill-amount-below-instalment-closes-the-occurrence",
      "why": "The linked bill decides when an occurrence is paid: 90 settles a bill of 90 even though the loan instalment is 100, so the loan moves on instead of offering a date the bill already closed.",
      "input": {
        "loan": {
          "openingPrincipal": 600.0,
          "annualRatePercent": 0.0,
          "termPeriods": 6,
          "interestMethod": "ReducingBalance",
          "trackingStartDate": "2026-08-01",
          "scheduleFrequency": "Monthly",
          "scheduleDueDay": 1,
          "scheduleStartDate": "2026-08-01",
          "scheduleStatus": "Complete"
        },
        "inputs": [
          {
            "occurrenceDate": "2026-08-01",
            "amount": 90.0,
            "isDiscarded": false,
            "billScheduledAmount": 90.0
          }
        ]
      },
      "expected": {
        "outstandingBalance": 510.0,
        "scheduledPayment": 100.0,
        "totalScheduledInterest": 0.0,
        "totalInterestPaid": 0.0,
        "payoffDate": "2027-02-01",
        "lastOccurrenceDate": "2026-08-01",
        "paymentCount": 1,
        "futureScheduleCount": 6,
        "firstFutureOccurrenceDate": "2026-09-01",
        "firstFuturePayment": 100.0
      }
    },
    {
      "id": "bill-amount-above-instalment-keeps-the-occurrence-open",
      "why": "A bill of 120 is still owed 20 after a full 100 instalment, so the loan keeps that date open for the remainder, as the bill does.",
      "input": {
        "loan": {
          "openingPrincipal": 600.0,
          "annualRatePercent": 0.0,
          "termPeriods": 6,
          "interestMethod": "ReducingBalance",
          "trackingStartDate": "2026-08-01",
          "scheduleFrequency": "Monthly",
          "scheduleDueDay": 1,
          "scheduleStartDate": "2026-08-01",
          "scheduleStatus": "Complete"
        },
        "inputs": [
          {
            "occurrenceDate": "2026-08-01",
            "amount": 100.0,
            "isDiscarded": false,
            "billScheduledAmount": 120.0
          }
        ]
      },
      "expected": {
        "outstandingBalance": 500.0,
        "scheduledPayment": 100.0,
        "totalScheduledInterest": 0.0,
        "totalInterestPaid": 0.0,
        "payoffDate": "2027-01-01",
        "lastOccurrenceDate": "2026-08-01",
        "paymentCount": 1,
        "futureScheduleCount": 6,
        "firstFutureOccurrenceDate": "2026-08-01",
        "firstFuturePayment": 20.0
      }
    }
  ]
}
