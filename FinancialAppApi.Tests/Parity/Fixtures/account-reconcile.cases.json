{
  "domain": "account-reconcile",
  "version": 1,
  "cases": [
    {
      "id": "pure-redistribution",
      "why": "Every changed account receives its own visible balance adjustment row, even when the bucket total is unchanged.",
      "input": {
        "operationId": "test-redistrib",
        "createdAt": 1755225600000,
        "bucket": "Essentials",
        "expectedBucketTotal": 100.0,
        "targets": [
          { "id": "acct-1", "name": "Bank", "expectedCurrent": 100.0, "target": 60.0, "isArchived": false },
          { "id": "acct-2", "name": "Cash", "expectedCurrent": 0.0, "target": 40.0, "isArchived": false }
        ]
      },
      "expected": [
        {
          "id": "reconcile-test-redistrib-adjustment-0",
          "description": "Account balance adjustment - Bank",
          "category": "Adjustment",
          "ledgerCategory": "Essentials",
          "amount": -40.0,
          "accountId": "acct-1",
          "counterAccountId": null,
          "isAccountBalanceAdjustment": true
        },
        {
          "id": "reconcile-test-redistrib-adjustment-1",
          "description": "Account balance adjustment - Cash",
          "category": "Adjustment",
          "ledgerCategory": "Essentials",
          "amount": 40.0,
          "accountId": "acct-2",
          "counterAccountId": null,
          "isAccountBalanceAdjustment": true
        }
      ]
    },
    {
      "id": "genuine-total-correction-upward",
      "why": "When target total exceeds the bucket total, each changed account receives its own adjustment.",
      "input": {
        "operationId": "test-upward",
        "createdAt": 1755225600000,
        "bucket": "Essentials",
        "expectedBucketTotal": 100.0,
        "targets": [
          { "id": "acct-1", "name": "Bank", "expectedCurrent": 100.0, "target": 120.0, "isArchived": false },
          { "id": "acct-2", "name": "Cash", "expectedCurrent": 0.0, "target": 30.0, "isArchived": false }
        ]
      },
      "expected": [
        {
          "id": "reconcile-test-upward-adjustment-0",
          "description": "Account balance adjustment - Bank",
          "category": "Adjustment",
          "ledgerCategory": "Essentials",
          "amount": 20.0,
          "accountId": "acct-1",
          "counterAccountId": null,
          "isAccountBalanceAdjustment": true
        },
        {
          "id": "reconcile-test-upward-adjustment-1",
          "description": "Account balance adjustment - Cash",
          "category": "Adjustment",
          "ledgerCategory": "Essentials",
          "amount": 30.0,
          "accountId": "acct-2",
          "counterAccountId": null,
          "isAccountBalanceAdjustment": true
        }
      ]
    },
    {
      "id": "genuine-total-correction-downward",
      "why": "When target total is below the bucket total, the changed account receives a negative adjustment.",
      "input": {
        "operationId": "test-downward",
        "createdAt": 1755225600000,
        "bucket": "Stability",
        "expectedBucketTotal": 200.0,
        "targets": [
          { "id": "acct-stab", "name": "Savings", "expectedCurrent": 200.0, "target": 150.0, "isArchived": false }
        ]
      },
      "expected": [
        {
          "id": "reconcile-test-downward-adjustment-0",
          "description": "Account balance adjustment - Savings",
          "category": "Adjustment",
          "ledgerCategory": "Stability",
          "amount": -50.0,
          "accountId": "acct-stab",
          "counterAccountId": null,
          "isAccountBalanceAdjustment": true
        }
      ]
    },
    {
      "id": "no-op-reconcile",
      "why": "When current balances already match targets, no transactions are generated.",
      "input": {
        "operationId": "test-noop",
        "createdAt": 1755225600000,
        "bucket": "Growth",
        "expectedBucketTotal": 300.0,
        "targets": [
          { "id": "acct-growth", "name": "Investments", "expectedCurrent": 300.0, "target": 300.0, "isArchived": false }
        ]
      },
      "expected": []
    },
    {
      "id": "credit-card-owed",
      "why": "A credit card may be set below zero: the negative balance is what is owed, recorded as an ordinary adjustment on the card.",
      "input": {
        "operationId": "test-card-owed",
        "createdAt": 1755225600000,
        "bucket": "Essentials",
        "expectedBucketTotal": 500.0,
        "targets": [
          { "id": "acct-bank", "name": "Bank", "expectedCurrent": 500.0, "target": 500.0, "isArchived": false },
          { "id": "acct-visa", "name": "Visa", "kind": "CreditCard", "expectedCurrent": 0.0, "target": -250.0, "isArchived": false }
        ]
      },
      "expected": [
        {
          "id": "reconcile-test-card-owed-adjustment-0",
          "description": "Account balance adjustment - Visa",
          "category": "Adjustment",
          "ledgerCategory": "Essentials",
          "amount": -250.0,
          "accountId": "acct-visa",
          "counterAccountId": null,
          "isAccountBalanceAdjustment": true
        }
      ]
    }
  ]
}
