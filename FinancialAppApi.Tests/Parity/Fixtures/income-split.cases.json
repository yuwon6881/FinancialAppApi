{
  "domain": "income-split",
  "version": 1,
  "cases": [
    {
      "id": "uncapped-standard-split",
      "why": "When stability target is 0 (uncapped), baseline allocations apply directly without redirect.",
      "input": {
        "amount": 4000.0,
        "essentialsAlloc": 0.5,
        "growthAlloc": 0.25,
        "stabilityAlloc": 0.15,
        "rewardsAlloc": 0.1,
        "stabilityBalance": 1000.0,
        "stabilityTarget": 0.0,
        "stabilityOverflowRedirect": "Growth 100%",
        "recoveryTopUp": 0.0
      },
      "expected": {
        "essentials": 0.5,
        "growth": 0.25,
        "stability": 0.15,
        "rewards": 0.1,
        "specString": "50,25,15,10"
      }
    },
    {
      "id": "already-capped-redirect-growth-100",
      "why": "When stability fund is already capped, 100% of stability allocation redirects to Growth.",
      "input": {
        "amount": 4000.0,
        "essentialsAlloc": 0.5,
        "growthAlloc": 0.2,
        "stabilityAlloc": 0.2,
        "rewardsAlloc": 0.1,
        "stabilityBalance": 5000.0,
        "stabilityTarget": 5000.0,
        "stabilityOverflowRedirect": "Growth 100%",
        "recoveryTopUp": 0.0
      },
      "expected": {
        "essentials": 0.5,
        "growth": 0.4,
        "stability": 0.0,
        "rewards": 0.1,
        "specString": "50,40,0,10"
      }
    },
    {
      "id": "already-capped-redirect-split-essentials-growth",
      "why": "When stability fund is capped and redirect is Split: Essentials 50%, Growth 50%, the stability share is halved between them.",
      "input": {
        "amount": 4000.0,
        "essentialsAlloc": 0.5,
        "growthAlloc": 0.2,
        "stabilityAlloc": 0.2,
        "rewardsAlloc": 0.1,
        "stabilityBalance": 5000.0,
        "stabilityTarget": 5000.0,
        "stabilityOverflowRedirect": "Split: Essentials 50%, Growth 50%",
        "recoveryTopUp": 0.0
      },
      "expected": {
        "essentials": 0.6,
        "growth": 0.3,
        "stability": 0.0,
        "rewards": 0.1,
        "specString": "60,30,0,10"
      }
    },
    {
      "id": "mid-deposit-cap-partial-redirect",
      "why": "When deposit partially fills stability fund, remaining stability share overflows to redirect targets.",
      "input": {
        "amount": 1000.0,
        "essentialsAlloc": 0.5,
        "growthAlloc": 0.2,
        "stabilityAlloc": 0.2,
        "rewardsAlloc": 0.1,
        "stabilityBalance": 4900.0,
        "stabilityTarget": 5000.0,
        "stabilityOverflowRedirect": "Rewards 100%",
        "recoveryTopUp": 0.0
      },
      "expected": {
        "essentials": 0.5,
        "growth": 0.2,
        "stability": 0.1,
        "rewards": 0.2,
        "specString": "50,20,10,20"
      }
    },
    {
      "id": "recovery-top-up-proportional-drawdown",
      "why": "An explicit recovery top-up adds to Stability by drawing down the other buckets proportionally.",
      "input": {
        "amount": 2000.0,
        "essentialsAlloc": 0.5,
        "growthAlloc": 0.25,
        "stabilityAlloc": 0.15,
        "rewardsAlloc": 0.1,
        "stabilityBalance": 1000.0,
        "stabilityTarget": 10000.0,
        "stabilityOverflowRedirect": "Growth 100%",
        "recoveryTopUp": 200.0
      },
      "expected": {
        "essentials": 0.441177,
        "growth": 0.220588,
        "stability": 0.25,
        "rewards": 0.088235,
        "specString": "44.1177,22.0588,25,8.8235"
      }
    }
  ]
}
