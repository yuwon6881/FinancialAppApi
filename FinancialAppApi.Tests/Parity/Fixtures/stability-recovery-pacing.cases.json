          { "originCycleKey": "2026-06", "transactionCount": 1, "cyclesRemaining": 3, "requiredThisCycle": 200, "isOverdue": false, "isDeferred": false },
          { "originCycleKey": "2026-07", "transactionCount": 1, "cyclesRemaining": 3, "requiredThisCycle": 0, "isOverdue": false, "isDeferred": true }
        ]
      }
    },
    {
      "id": "missed-share-catches-up-in-final-cycle",
      "why": "An unpaid cohort is divided over the cycles still available, with its whole remainder due in the third and final repayment cycle.",
      "input": {
        "currentCycleKey": "2026-09",
        "horizon": 3,
        "outstandingShortfall": 900,
        "toppedUpThisCycle": 0,
        "cohorts": [
          { "originCycleKey": "2026-06", "fromDate": "2026-06-04", "transactionCount": 1, "remainingShortfall": 900, "repaidThisCycle": 0 }
        ]
      },
      "expected": {
        "cyclesRemaining": 1,
        "requiredThisCycle": 900,
        "outstandingThisCycle": 900,
        "isOverdue": false,
        "isDeferred": false,
        "cohorts": [
          { "originCycleKey": "2026-06", "transactionCount": 1, "cyclesRemaining": 1, "requiredThisCycle": 900, "isOverdue": false, "isDeferred": false }
        ]
      }
    },
    {
      "id": "overdue-and-new-cohorts-coexist",
      "why": "A cohort past its three repayment cycles owes its whole remainder while a newer cohort retains its own share; the combined plan is not deferred by the newer one.",
