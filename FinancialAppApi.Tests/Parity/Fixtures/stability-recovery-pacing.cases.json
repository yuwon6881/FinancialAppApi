{
  "domain": "stability-recovery-pacing",
  "version": 1,
  "cases": [
    {
      "id": "new-drawdown-keeps-three-cycles",
      "why": "A drawdown in the second cycle starts a new three-cycle cohort instead of inheriting the older cohort's two remaining cycles.",
      "input": {
        "currentCycleKey": "2026-07",
        "horizon": 3,
        "outstandingShortfall": 900,
        "toppedUpThisCycle": 0,
        "cohorts": [
          { "originCycleKey": "2026-06", "fromDate": "2026-06-04", "transactionCount": 1, "remainingShortfall": 600, "repaidThisCycle": 0 },
          { "originCycleKey": "2026-07", "fromDate": "2026-07-04", "transactionCount": 1, "remainingShortfall": 300, "repaidThisCycle": 0 }
        ]
      },
      "expected": {
        "cyclesRemaining": 2,
        "requiredThisCycle": 400,
        "outstandingThisCycle": 400,
        "isOverdue": false,
        "cohorts": [
          { "originCycleKey": "2026-06", "transactionCount": 1, "cyclesRemaining": 2, "requiredThisCycle": 300, "isOverdue": false },
          { "originCycleKey": "2026-07", "transactionCount": 1, "cyclesRemaining": 3, "requiredThisCycle": 100, "isOverdue": false }
        ]
      }
    },
    {
      "id": "combined-credit-does-not-shrink-cohort-quotes",
      "why": "Current-cycle reimbursement holds the older cohort's quote still and then reduces the combined amount due.",
      "input": {
        "currentCycleKey": "2026-07",
        "horizon": 3,
        "outstandingShortfall": 800,
        "toppedUpThisCycle": 100,
        "cohorts": [
          { "originCycleKey": "2026-06", "fromDate": "2026-06-04", "transactionCount": 1, "remainingShortfall": 500, "repaidThisCycle": 100 },
          { "originCycleKey": "2026-07", "fromDate": "2026-07-04", "transactionCount": 1, "remainingShortfall": 300, "repaidThisCycle": 0 }
        ]
      },
      "expected": {
        "cyclesRemaining": 2,
        "requiredThisCycle": 400,
        "outstandingThisCycle": 300,
        "isOverdue": false,
        "cohorts": [
          { "originCycleKey": "2026-06", "transactionCount": 1, "cyclesRemaining": 2, "requiredThisCycle": 300, "isOverdue": false },
          { "originCycleKey": "2026-07", "transactionCount": 1, "cyclesRemaining": 3, "requiredThisCycle": 100, "isOverdue": false }
        ]
      }
    },
    {
      "id": "same-cycle-withdrawals-share-one-cohort",
      "why": "Several withdrawals in one financial cycle are one paced cohort but retain their transaction count.",
      "input": {
        "currentCycleKey": "2026-07",
        "horizon": 3,
        "outstandingShortfall": 100,
        "toppedUpThisCycle": 0,
        "cohorts": [
          { "originCycleKey": "2026-07", "fromDate": "2026-07-03", "transactionCount": 1, "remainingShortfall": 40, "repaidThisCycle": 0 },
          { "originCycleKey": "2026-07", "fromDate": "2026-07-09", "transactionCount": 1, "remainingShortfall": 60, "repaidThisCycle": 0 }
        ]
      },
      "expected": {
        "cyclesRemaining": 3,
        "requiredThisCycle": 33.34,
        "outstandingThisCycle": 33.34,
        "isOverdue": false,
        "cohorts": [
          { "originCycleKey": "2026-07", "transactionCount": 2, "cyclesRemaining": 3, "requiredThisCycle": 33.34, "isOverdue": false }
        ]
      }
    },
    {
      "id": "missed-share-catches-up-in-final-cycle",
      "why": "An unpaid cohort is divided over the cycles still available, with its whole remainder due in the final cycle.",
      "input": {
        "currentCycleKey": "2026-08",
        "horizon": 3,
        "outstandingShortfall": 900,
        "toppedUpThisCycle": 0,
        "cohorts": [
          { "originCycleKey": "2026-06", "fromDate": "2026-06-04", "transactionCount": 1, "remainingShortfall": 900, "repaidThisCycle": 0 }
        ]
      },
      "expected": {
        "cyclesRemaining": 1,
        "requiredThisCycle": 900,
        "outstandingThisCycle": 900,
        "isOverdue": false,
        "cohorts": [
          { "originCycleKey": "2026-06", "transactionCount": 1, "cyclesRemaining": 1, "requiredThisCycle": 900, "isOverdue": false }
        ]
      }
    },
    {
      "id": "overdue-and-new-cohorts-coexist",
      "why": "An overdue cohort owes its whole remainder while a newer cohort retains its own three-cycle share.",
      "input": {
        "currentCycleKey": "2026-07",
        "horizon": 3,
        "outstandingShortfall": 120,
        "toppedUpThisCycle": 0,
        "cohorts": [
          { "originCycleKey": "2026-04", "fromDate": "2026-04-01", "transactionCount": 1, "remainingShortfall": 20, "repaidThisCycle": 0 },
          { "originCycleKey": "2026-07", "fromDate": "2026-07-01", "transactionCount": 1, "remainingShortfall": 100, "repaidThisCycle": 0 }
        ]
      },
      "expected": {
        "cyclesRemaining": 1,
        "requiredThisCycle": 53.34,
        "outstandingThisCycle": 53.34,
        "isOverdue": true,
        "cohorts": [
          { "originCycleKey": "2026-04", "transactionCount": 1, "cyclesRemaining": 1, "requiredThisCycle": 20, "isOverdue": true },
          { "originCycleKey": "2026-07", "transactionCount": 1, "cyclesRemaining": 3, "requiredThisCycle": 33.34, "isOverdue": false }
        ]
      }
    },
    {
      "id": "combined-credit-clamps-at-live-shortfall",
      "why": "Paying ahead can cover the current combined plan without hiding the remaining future shortfall or producing a negative ask.",
      "input": {
        "currentCycleKey": "2026-07",
        "horizon": 3,
        "outstandingShortfall": 35,
        "toppedUpThisCycle": 80,
        "cohorts": [
          { "originCycleKey": "2026-07", "fromDate": "2026-07-01", "transactionCount": 1, "remainingShortfall": 35, "repaidThisCycle": 80 }
        ]
      },
      "expected": {
        "cyclesRemaining": 3,
        "requiredThisCycle": 38.34,
        "outstandingThisCycle": 0,
        "isOverdue": false,
        "cohorts": [
          { "originCycleKey": "2026-07", "transactionCount": 1, "cyclesRemaining": 3, "requiredThisCycle": 38.34, "isOverdue": false }
        ]
      }
    }
  ]
}
