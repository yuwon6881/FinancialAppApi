{
  "domain": "stability-recovery-pacing",
  "version": 2,
  "cases": [
    {
      "id": "spending-cycle-asks-for-nothing",
      "why": "The cycle the money left in only carries the reminder: its plan opens next cycle, so nothing is due yet and the state says so rather than looking like a funded cycle.",
      "input": {
        "currentCycleKey": "2026-07",
        "horizon": 3,
        "outstandingShortfall": 100,
        "toppedUpThisCycle": 0,
        "cohorts": [
          { "originCycleKey": "2026-07", "fromDate": "2026-07-03", "transactionCount": 1, "remainingShortfall": 40, "repaidThisCycle": 0 },
          { "originCycleKey": "2026-07", "fromDate": "2026-07-09", "transactionCount": 1, "remainingShortfall": 60, "repaidThisCycle": 0 }
        ]
      },
      "expected": {
        "cyclesRemaining": 3,
        "requiredThisCycle": 0,
        "outstandingThisCycle": 0,
        "isOverdue": false,
        "isDeferred": true,
        "cohorts": [
          { "originCycleKey": "2026-07", "transactionCount": 2, "cyclesRemaining": 3, "requiredThisCycle": 0, "isOverdue": false, "isDeferred": true }
        ]
      }
    },
    {
      "id": "repayment-starts-the-cycle-after-spending",
      "why": "Several withdrawals in one financial cycle are one paced cohort, and that cohort's first instalment falls in the following cycle.",
      "input": {
        "currentCycleKey": "2026-08",
        "horizon": 3,
        "outstandingShortfall": 100,
        "toppedUpThisCycle": 0,
        "cohorts": [
          { "originCycleKey": "2026-07", "fromDate": "2026-07-03", "transactionCount": 1, "remainingShortfall": 40, "repaidThisCycle": 0 },
          { "originCycleKey": "2026-07", "fromDate": "2026-07-09", "transactionCount": 1, "remainingShortfall": 60, "repaidThisCycle": 0 }
        ]
      },
      "expected": {
        "cyclesRemaining": 3,
        "requiredThisCycle": 33.34,
        "outstandingThisCycle": 33.34,
        "isOverdue": false,
        "isDeferred": false,
        "cohorts": [
          { "originCycleKey": "2026-07", "transactionCount": 2, "cyclesRemaining": 3, "requiredThisCycle": 33.34, "isOverdue": false, "isDeferred": false }
        ]
      }
    },
    {
      "id": "early-put-back-in-the-spending-cycle-still-counts",
      "why": "Nothing is asked for during the spending cycle, but money put back anyway is credited and shrinks what the first real instalment will divide.",
      "input": {
        "currentCycleKey": "2026-07",
        "horizon": 3,
        "outstandingShortfall": 60,
        "toppedUpThisCycle": 40,
        "cohorts": [
          { "originCycleKey": "2026-07", "fromDate": "2026-07-03", "transactionCount": 1, "remainingShortfall": 60, "repaidThisCycle": 40 }
        ]
      },
      "expected": {
        "cyclesRemaining": 3,
        "requiredThisCycle": 0,
        "outstandingThisCycle": 0,
        "isOverdue": false,
        "isDeferred": true,
        "cohorts": [
          { "originCycleKey": "2026-07", "transactionCount": 1, "cyclesRemaining": 3, "requiredThisCycle": 0, "isOverdue": false, "isDeferred": true }
        ]
      }
    },
    {
      "id": "new-drawdown-keeps-three-cycles",
