        "isOverdue": false,
        "isDeferred": false,
        "cohorts": [
          { "originCycleKey": "2026-07", "transactionCount": 1, "cyclesRemaining": 3, "requiredThisCycle": 38.34, "isOverdue": false, "isDeferred": false }
