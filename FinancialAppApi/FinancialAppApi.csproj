<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Cold-start optimizations for Cloud Run scale-to-zero. ReadyToRun precompiles
         IL to native at publish time so the first request doesn't pay full JIT cost;
         TieredPGO improves steady-state throughput once warm. Both are free and require
         a RuntimeIdentifier, which the Dockerfile passes at publish time (linux-x64). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <UserSecretsId>4b6f3c94-1d61-4fff-902e-45ed68869c02</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal AI intent/forecast/sufficiency types so the test project can assert
         on typed results rather than serialized prompt substrings (Phase 9). -->
    <InternalsVisibleTo Include="FinancialAppApi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Fido2" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="Google.Apis.Auth" />
  </ItemGroup>

</Project>
